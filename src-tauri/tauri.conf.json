{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MavroDPI",
  "version": "0.2.4",
  "identifier": "com.mavro.dpi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MavroDPI",
        "width": 760,
        "height": 680,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": [
      "resources/goodbyedpi/**/*",
      "resources/mavrodpi-svc.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsi",
        "minimumWebview2Version": "2.0.0"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5QkFCQUM5MUVBRjE5MTIKUldRU0dhOGV5YnE2S1dsYXRWeld6d1A0Y0J2bVpPT0ZkV0c2d0YrRVJkcEZKUDUzcnFaVE9iRlIK",
      "endpoints": [
        "https://github.com/Mavrom/mavrodpi/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}
