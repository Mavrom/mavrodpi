{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MavroDPI",
  "version": "0.3.0",
  "identifier": "com.mavro.dpi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MavroDPI",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": [
      "resources/goodbyedpi/**/*",
      "resources/mavrodpi-svc.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis/hooks.nsi",
        "minimumWebview2Version": "110.0.1587.41"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5QkFCQUM5MUVBRjE5MTIKUldRU0dhOGV5YnE2S1dsYXRWeld6d1A0Y0J2bVpPT0ZkV0c2d0YrRVJkcEZKUDUzcnFaVE9iRlIK",
      "endpoints": [
        "https://github.com/Mavrom/mavrodpi/releases/latest/download/latest.json"
      ],
      "dialog": true
    }
  }
}
